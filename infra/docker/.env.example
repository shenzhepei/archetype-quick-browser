PLATFORM_DATABASE_PASSWORD=replace-with-a-random-password
DEMO_POSTGRES_PASSWORD=demo
DEMO_MYSQL_PASSWORD=demo
DEMO_MYSQL_ROOT_PASSWORD=replace-with-a-random-password
ARCHETYPE_ADMIN_TOKEN=replace-with-at-least-32-random-bytes
ARCHETYPE_SERVICE_TOKEN=replace-with-at-least-32-random-bytes
ARCHETYPE_MASTER_KEY=replace-with-at-least-32-random-bytes
ARCHETYPE_PUBLIC_URL=http://localhost:8787
ARCHETYPE_CONTROL_DEV_LOGIN=true
ARCHETYPE_CONTROL_ORGANIZATION_ID=default
ARCHETYPE_CONTROL_ORGANIZATION_NAME=Local development
ARCHETYPE_CONTROL_BOOTSTRAP_SUBJECTS=development-admin
